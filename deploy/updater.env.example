# Settings for the Telegram updater bot (git-ignored when copied to updater.env).
# Install location: /etc/processor-updater/updater.env, mode 600. Placeholders only.

# Bot token from @BotFather, as a file (preferred) so it never shows in `docker inspect`:
UPDATER_TELEGRAM_TOKEN_FILE=/run/secrets/telegram_token
# Telegram user ids allowed to use the bot, space or comma separated. Send /id to the bot to see yours.
UPDATER_ALLOWED_IDS=
# GitHub repository to take release tags from.
UPDATER_REPO=realsystem/processor
# Require green CI on the tagged commit (default true).
UPDATER_REQUIRE_CI=true
# Optional GitHub token (no scopes needed for a public repo) for a higher API rate limit.
#UPDATER_GITHUB_TOKEN_FILE=/run/secrets/github_token
