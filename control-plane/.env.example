# Database
DATABASE_PATH=./processor.db

# Secrets (CHANGE THESE IN PRODUCTION!)
# Generate with: openssl rand -hex 32
SESSION_SECRET=dev-session-secret-change-in-production
WORKER_TOKEN=dev-worker-token-change-in-production

# Application
BASE_URL=http://localhost:8080
HTTP_PORT=8080
ENV=development

# Admin Bootstrap (first run only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# SMTP (optional, for email notifications)
# Leave blank to use log-based email provider in development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@processor.local

# Logging
LOG_LEVEL=info
