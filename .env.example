# Processor Environment Configuration
# Copy this file to .env and fill in your actual values

# SMTP Email Configuration (optional - for email notifications)
# If not set, emails will be logged to console instead
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=your-email@gmail.com

# Security
SESSION_SECRET=change-this-to-a-random-string-in-production
WORKER_TOKEN=change-this-to-a-random-string

# Admin User (created on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Application Settings
ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
LEASE_DURATION=5m
DATABASE_PATH=/data/processor.db

# LLM models offered in the web job form and by GET /api/v1/models (comma-separated; must be
# pulled on the worker). LLM_DEFAULT_MODEL is preselected and always part of the list.
# LLM_MODELS=llama3.2,gemma2:2b,qwen2.5:7b,llama3.1:8b,qwen2.5:14b
# LLM_DEFAULT_MODEL=llama3.2

# Telegram bot (optional, see docs/telegram-bot.md)
# TELEGRAM_BOT_TOKEN=123456:XXXX_from_BotFather
# TELEGRAM_ALLOWED_USERS=123456789
# PROCESSOR_API_KEY=pk_XXX
